# Copy to .env locally. Never commit real secrets.
# Phase 0+: fill only what a spike needs.

# Supabase (public anon key is OK in client builds; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare TURN (Edge Function secret — not for the browser)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Email (Supabase custom SMTP / Edge Functions)
BREVO_SMTP_USER=
BREVO_SMTP_KEY=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Telegram bot
TELEGRAM_BOT_TOKEN=

# Google OAuth (if used)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Feature flags / caps (examples)
LANE3_ENABLED=false
DAILY_RELAY_MINUTES_PER_MEMBER=60
